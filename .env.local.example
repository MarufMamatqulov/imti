# AI yordamchi (OpenAI) uchun sozlamalar
# Real qiymatlarni shu nom bilan .env.local (lokal) yoki Vercel loyihasi
# Environment Variables bo'limiga qo'shing. Bu fayl faqat namuna.

OPENAI_API_KEY=sk-...

# Ixtiyoriy: modelni almashtirish uchun (standart: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Aloqa shakli (Murojaat yuborish) — Telegramga yuboradi
# 1. Telegramda @BotFather ga yozing -> /newbot -> bot nomini bering -> sizga
#    token beriladi (masalan: 123456789:AAExampleTokenHere)
# 2. Murojaatlar tushadigan kanal yoki guruh yarating, botni unga a'zo/admin
#    qiling (xabar yuborishi uchun admin huquqi kerak)
# 3. chat_id ni topish uchun: kanalga istalgan xabar yozing, so'ng brauzerda
#    https://api.telegram.org/bot<TOKEN>/getUpdates manziliga kiring va
#    natijadagi "chat":{"id": ...} qiymatini oling (kanal uchun odatda -100
#    bilan boshlanadi)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenHere
TELEGRAM_CHAT_ID=-1001234567890
